{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zafe-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/waitlist", "/join", "/join/"]
  },
  "vars": {
    "TESTNET_HOST": "testnet.zafe.cash"
  },
  "kv_namespaces": [{ "binding": "WAITLIST", "id": "d726edc6fdc84413a186fc637e46d8fd" }],
  "routes": [
    { "pattern": "zafe.cash", "custom_domain": true },
    { "pattern": "testnet.zafe.cash", "custom_domain": true }
  ],
  "workers_dev": true,
  "preview_urls": true
}
