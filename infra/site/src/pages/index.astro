---
// Home page (direction: .impeccable/surfaces/src-pages-index-astro.md). One centred column:
// the headline and the two ways to install, then the story in four illustrated loops (one
// room; each scene moves with the app's own card, infra/site/scenes + film): your phone
// checks every payment; two of three approve, it's sent; one key, never in one place;
// quiet until it needs you (then the features); the close, questions.
// The only script is loops.js (pause buttons, no play off screen); with reduced motion each
// loop is a still. Every claim is shipped (docs/tracker.md); the link under the sending loop
// is the real testnet payment from the 2026-09-30 dry run.
import Base from '../layouts/Base.astro';
import PlayButton from '../components/PlayButton.astro';
import IphoneButton from '../components/IphoneButton.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Mark from '../components/Mark.astro';
import Icon from '../components/Icon.astro';
import Loop from '../components/Loop.astro';
import BrandIcon from '../components/BrandIcon.astro';
import { downloadUrl, playUrl, sourceUrl, specUrl } from '../config';

const faq = [
  { q: 'Is it safe to use?', a: 'It’s a beta, so start small. The key is split across your phones and never put together, and the app, the server and the spec are open source.' },
  { q: 'Has it been audited?', a: 'Not yet. An external audit of the key, signing and checking code is planned, and its scope is public in the repository. Where Zafe differs from the Zcash drafts, the Zcash Foundation has confirmed the approach. Until the audit, keep amounts small.' },
  { q: 'Is it really a multisig?', a: 'Yes. Each phone holds a share of the key (FROST), and enough of them sign together. The chain sees one ordinary signature.' },
  { q: 'What if someone loses their phone?', a: 'They restore their backup, or the others move their seat to a new phone. Lose more phones than your rule allows, with no backups, and the funds are gone.' },
  { q: 'Will I need to update?', a: 'Yes, before Zcash’s NU7 upgrade on November 5. Update together.' },
  { q: 'iPhone?', a: 'Coming. Tap the Apple icon under “Get Zafe” to join the waitlist, and we’ll send one email when it’s out.' },
];

// SEO (docs/seo.md): <title> carries the search terms, the share cards the tagline.
const description =
  'A private multisig wallet for Zcash. Nothing moves until enough of you approve, and on-chain it looks like any payment.';
const home = Astro.site!.href;
// schema.org data for search engines; every value must match what the page says.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${home}#org`,
      name: 'Zafe',
      url: home,
      logo: new URL('/assets/icons/icon-512.png', home).href,
      sameAs: [sourceUrl, 'https://x.com/zafecash', playUrl],
    },
    {
      '@type': 'WebSite',
      '@id': `${home}#website`,
      name: 'Zafe',
      url: home,
      publisher: { '@id': `${home}#org` },
    },
    {
      '@type': 'MobileApplication',
      name: 'Zafe',
      description,
      operatingSystem: 'Android',
      applicationCategory: 'FinanceApplication',
      installUrl: playUrl,
      ...(downloadUrl ? { downloadUrl } : {}),
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      publisher: { '@id': `${home}#org` },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  ],
};

---

<Base
  title="Zafe: private multisig wallet for Zcash"
  socialTitle="Zafe: the multisig nobody can see"
  description={description}
  jsonLd={jsonLd}
  bodyClass="home landing"
>
  <!-- Intro (CSS only): the screen is the mark's tile, its two pieces lock, then it
       collapses up into the nav logo while the page appears. Skipped with
       prefers-reduced-motion. -->
  <div class="intro" aria-hidden="true">
    <div class="intro-veil"></div>
    <div class="intro-ring"></div>
    <div class="intro-ring second"></div>
    <div class="intro-mark"><Mark /></div>
  </div>
  <script is:inline slot="head" src="/assets/js/loops.js" defer></script>
  <Nav />

  <main>
    <section class="hc-hero">
      <PlayButton id="play-badge" class="hc-badge"><BrandIcon name="googleplay" /><span>Beta</span>Now on Google Play</PlayButton>
      <h1>The Zcash multisig nobody can see</h1>
      <p class="hc-sub">One shielded vault for your group. Nothing moves until enough of you approve.</p>
      <div class="hx-actions">
        <a class="hx-play hx-get-zafe" href="/download">Get Zafe</a>
      </div>
    </section>

    <div class="hc-band">
    <div class="hc-tab">
      <PlayButton id="play-tab" icon />
      <IphoneButton id="ios-tab" icon />
    </div>
    <section id="how" class="hc-step" aria-labelledby="sign-title">
      <h2 id="sign-title">Your phone checks every payment</h2>
      <p>Maya asks to send 12.50 ZEC. Before you approve, it confirms the recipient, the amount and the fee.</p>
      <Loop
        name="sign"
        eager
        alt="Maya’s request for 12.50 ZEC on a desk, approved; a wax stamp seals the envelope"
        text={['Maya asks to send 12.50 ZEC.', 'Your phone checks the real transaction, and you approve it.']}
      />
    </section>
    </div>

    <section class="hc-step" aria-labelledby="sent-title">
      <h2 id="sent-title">Two of three approve. It&rsquo;s sent.</h2>
      <p>No one gathers signatures. The chain sees an ordinary payment, not who approved it.</p>
      <Loop
        name="sent"
        alt="“Sent!” beside a brass pneumatic tube that has just taken the sealed payment"
        text={['Two of three approve, and the payment is sent.', 'The chain sees an ordinary payment: recipient and amount encrypted, approvers hidden.']}
      >
        <figcaption>Sample data. <a href="https://testnet.zecblock.com/tx/e6ccd6b707e8ee7ed8b261855272dba317495afa6659e393d3f1691e9eef0237" target="_blank" rel="noopener noreferrer">See a real Zafe payment on the chain</a></figcaption>
      </Loop>
    </section>

    <section id="setup" class="hc-step" aria-labelledby="setup-title">
      <h2 id="setup-title">One key, never in one place</h2>
      <p>You set up the vault on your phones together. Each keeps a share; no one ever holds all of it.</p>
      <Loop
        name="setup"
        alt="Three keys turned in a strongbox on a round table, beside “Vault keys ready”"
        text={['You create the vault and share the invite with your co-signers.', 'Everyone sees the same four safety words and compares them.', 'The phones make the key together. Each keeps one share; nobody holds all of it.']}
      />
    </section>

    <section class="hc-step" aria-labelledby="live-title">
      <h2 id="live-title">Quiet until it needs you</h2>
      <p>You get a notification when a payment is waiting for you.</p>
      <Loop
        name="live"
        alt="The vault’s balance with a request from Maya waiting, at a desk in the evening, a cat asleep"
        text={['The vault at rest: its balance, and a request from Maya waiting for you.']}
      />
      <div class="hc-live">
      <ul>
        <li><Icon name="wallet" />Several vaults on one phone</li>
        <li><Icon name="history" />History export for your books</li>
        <li><Icon name="eye" />A viewing key for your accountant</li>
        <li><Icon name="lock" />Encrypted backups</li>
        <li><Icon name="users" />Move a lost phone&rsquo;s seat</li>
        <li><Icon name="tor" />Tor for every connection</li>
      </ul>
      </div>
    </section>

    <section class="hc-close" aria-labelledby="close-title">
      <h2 id="close-title">Get Zafe</h2>
      <p>Free on Android. iPhone soon.</p>
      <div class="hx-actions">
        <PlayButton id="play-close" />
        <IphoneButton id="ios-close" />
      </div>
    </section>

    <section id="faq" class="hx-faq" aria-labelledby="faq-title">
      <h2 id="faq-title">Questions</h2>
      <div class="qa">
        {faq.map((item, i) => (
          <details open={i === 0}>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Base>
