---
// Home page, structured like safe.global (hero, how it works, features, security, a
// comparison, FAQ, call to action) to Zafe's rules: light, few words, every claim
// shipped (docs/tracker.md), no invented numbers. Calm on purpose: no JavaScript, motion
// in CSS only; the 3D story lives on /showcase. Pictures are the app's real screens
// (assets.py), the way safe.global shows its product; one still of the 3D world is the
// door to /showcase. The chain card is the real testnet payment from the 2026-09-30 dry run.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Mark from '../components/Mark.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { downloadUrl, getLabel, getNote, getUrl, sourceUrl, specUrl } from '../config';

const faq = [
  { q: 'Is Zafe safe to use?', a: 'It’s on testnet and not yet audited. Everything is open source. Don’t use real funds yet.' },
  { q: 'Is it really a multisig?', a: 'Yes, just not on-chain. Each phone holds a key share (FROST), and enough shares make one ordinary signature.' },
  { q: 'What can the relay see?', a: 'Who messages whom, and when. Never amounts, addresses or keys. It can’t sign or move funds.' },
  { q: 'Does Zafe track me?', a: 'No. There are no analytics, no crash reports and no third-party SDKs, in the app or on this site. If something breaks, the app keeps a scrubbed error log on your phone, and it leaves only if you share it.' },
  { q: 'What if someone loses their phone?', a: 'The vault keeps working while enough members have theirs, and the share comes back from its encrypted backup. Lose too many, and the funds are gone for good.' },
  { q: 'Can we remove a member?', a: 'Not yet. Make a new vault and move the funds.' },
  { q: 'Which platforms?', a: 'Android. iPhone later.' },
];

// SEO (docs/seo.md): <title> carries the search terms, the share cards the tagline.
const description =
  'A private multisig wallet for Zcash teams and DAOs. Nothing moves until enough of you approve, and on-chain it looks like any payment.';
const home = Astro.site!.href;
// schema.org data for search engines; every value must match what the page says.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${home}#org`,
      name: 'Zafe',
      url: home,
      logo: new URL('/assets/icons/icon-512.png', home).href,
      sameAs: [sourceUrl],
    },
    {
      '@type': 'WebSite',
      '@id': `${home}#website`,
      name: 'Zafe',
      url: home,
      publisher: { '@id': `${home}#org` },
    },
    {
      '@type': 'MobileApplication',
      name: 'Zafe',
      description,
      operatingSystem: 'Android',
      applicationCategory: 'FinanceApplication',
      ...(downloadUrl ? { downloadUrl } : {}),
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      publisher: { '@id': `${home}#org` },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  ],
};
---

<Base
  title="Zafe: private multisig wallet for Zcash teams"
  socialTitle="Zafe: the multisig nobody can see"
  description={description}
  jsonLd={jsonLd}
  bodyClass="home landing"
>
  <!-- Intro (CSS only): the screen is the mark's tile, its two pieces lock, then it
       collapses up into the nav logo while the page appears. Skipped with
       prefers-reduced-motion. -->
  <div class="intro" aria-hidden="true">
    <div class="intro-veil"></div>
    <div class="intro-ring"></div>
    <div class="intro-ring second"></div>
    <div class="intro-mark"><Mark /></div>
  </div>
  <Nav links={[{ href: '#how', label: 'How it works' }, { href: '#security', label: 'Security' }, { href: '/showcase', label: 'Showcase', mobile: true }]} />

  <main>
    <!-- Hero: the headline, and the app itself (real renders, assets.py). -->
    <section class="lp-hero">
      <div class="lp-hero-copy">
        <p class="tag">Now on testnet</p>
        <h1>The multisig<br />nobody can see</h1>
        <p class="sub">One private vault for your team. Nothing moves until enough of you approve.</p>
        <div class="lp-actions">
          <a class="pill" href={getUrl} target="_blank" rel="noopener noreferrer">{getLabel}</a>
          <a class="lp-more" href="/showcase">Watch it in 3D <Icon name="chevron_forward" /></a>
        </div>
      </div>
      <div class="lp-hero-art" aria-hidden="true">
        <div class="lp-dial"></div>
        <img class="lp-phone lp-phone-back" src="/assets/screens/story_bob_propose_dark.webp" width="780" height="1688" alt="" decoding="async" />
        <img class="lp-phone lp-phone-front" src="/assets/screens/story_me_home_light.webp" width="780" height="1688" alt="" fetchpriority="high" decoding="async" />
      </div>
    </section>

    <ul class="lp-facts" aria-label="At a glance">
      <li><Icon name="eye_closed" />Shielded on Zcash</li>
      <li><Icon name="key" />Threshold signatures (FROST)</li>
      <li><Icon name="book" />Open source</li>
      <li><Icon name="tor" />Tor built in</li>
    </ul>

    <!-- How it works: one payment through the app's real screens, a big phone per step. -->
    <section id="how" class="lp-section">
      <header class="lp-head">
        <p class="tag">How it works</p>
        <h2>Three phones.<br />One vault.</h2>
      </header>
      <ol class="lp-flow">
        <li>
          <div class="lp-flow-copy">
            <h3>Someone proposes</h3>
            <p>Anyone in the vault drafts a payment. Nothing moves yet.</p>
          </div>
          <div class="lp-flow-art dark"><img class="lp-phone" src="/assets/screens/story_bob_propose_dark.webp" width="780" height="1688" alt="Zafe's review screen: a new payment of 12.50 TAZ, 2 of 3 signers needed" loading="lazy" decoding="async" /></div>
        </li>
        <li>
          <div class="lp-flow-copy">
            <h3>Everyone checks, then approves</h3>
            <p>Each phone checks the payment on its own. One tap to approve.</p>
          </div>
          <div class="lp-flow-art"><img class="lp-phone" src="/assets/screens/story_me_review_light.webp" width="780" height="2400" alt="A payment with one of two approvals, checked on this device, and the Approve and sign button" loading="lazy" decoding="async" /></div>
        </li>
        <li>
          <div class="lp-flow-copy">
            <h3>It sends itself</h3>
            <p>Once enough of you approve, it goes. On-chain, it looks like any payment.</p>
          </div>
          <div class="lp-flow-art gold"><img class="lp-phone" src="/assets/screens/story_me_sending_light.webp" width="780" height="1688" alt="Zafe's sending screen: coins leaving the vault" loading="lazy" decoding="async" /></div>
        </li>
      </ol>
    </section>

    <!-- The one picture of the 3D world on this page: the door to the showcase. -->
    <a class="lp-teaser" href="/showcase">
      <picture>
        <source media="(max-width: 760px)" srcset="/assets/stills/hero_tall.webp" width="780" height="1688" />
        <img src="/assets/stills/hero_wide.webp" width="1440" height="900" alt="" loading="lazy" decoding="async" />
      </picture>
      <span class="lp-teaser-copy">
        <span class="tag">Showcase</span>
        <strong>Watch one payment in 3D</strong>
        <span class="lp-more">Open the showcase <Icon name="chevron_forward" /></span>
      </span>
    </a>

    <section id="features" class="lp-section">
      <header class="lp-head">
        <p class="tag">Features</p>
        <h2>Your treasury,<br />held together</h2>
      </header>
      <div class="lp-cards">
        <article class="lp-card lp-card-shot">
          <div class="lp-card-copy">
            <h3>Checked on every phone</h3>
            <p>Your phone checks each payment against the vault&rsquo;s own keys: recipients, amounts, change and fee. If anything&rsquo;s off, it won&rsquo;t sign.</p>
          </div>
          <div class="lp-crop"><img src="/assets/screens/story_me_review_light.webp" width="780" height="2400" alt="The payment's details on the review screen, checked on this device: matches" loading="lazy" decoding="async" /></div>
        </article>
        <article class="lp-card">
          <h3>Invisible on-chain</h3>
          <p>The phones sign together as one. To the chain it&rsquo;s an ordinary shielded payment, like this real one from our testnet trial.</p>
          <dl class="lp-chain">
            <div><dt>tx</dt><dd>e6ccd6b7&hellip;9eef0237</dd></div>
            <div><dt>block</dt><dd>4,422,289</dd></div>
            <div><dt>to</dt><dd class="enc">encrypted</dd></div>
            <div><dt>amount</dt><dd class="enc">encrypted</dd></div>
          </dl>
        </article>
        <article class="lp-card">
          <h3>Private all the way</h3>
          <ul class="lp-list">
            <li><Icon name="tor" />Optional Tor for every connection</li>
            <li><Icon name="lock" />Encrypted backups</li>
            <li><Icon name="eye" />Viewing keys for auditors</li>
            <li><Icon name="unlock" />Unlock your phone to sign</li>
          </ul>
        </article>
      </div>
    </section>

    <section id="security" class="lp-section lp-security">
      <header class="lp-sec-head">
        <p class="tag">Security</p>
        <h2>Nothing to take<br />on trust</h2>
        <p class="lp-warn"><Icon name="warning" /><span><strong>Testnet only, for now.</strong> Zafe hasn&rsquo;t been audited yet. Don&rsquo;t use real funds.</span></p>
      </header>
      <ul class="lp-rows">
        <li>
          <Icon name="key" />
          <div><h3>No single key</h3><p>The key is split across your phones and never put together, not even to sign.</p></div>
        </li>
        <li>
          <Icon name="eye_closed" />
          <div><h3>A blind relay</h3><p>Phones talk through a relay that sees who and when. Never amounts, addresses or keys.</p></div>
        </li>
        <li>
          <Icon name="eye_closed" />
          <div><h3>No telemetry</h3><p>No analytics, no crash reports, no third-party SDKs. A build check fails if one is added.</p></div>
        </li>
        <li>
          <Icon name="book" />
          <div><h3>Open source</h3><p>The app, the relay and the <a href={specUrl} target="_blank" rel="noopener noreferrer">spec</a> are all <a href={sourceUrl} target="_blank" rel="noopener noreferrer">public</a>.</p></div>
        </li>
      </ul>
    </section>

    <section class="lp-section">
      <header class="lp-head">
        <p class="tag">Compare</p>
        <h2>Not all multisigs<br />are equal</h2>
      </header>
      <div class="lp-compare" role="region" aria-label="Comparison" tabindex="0">
        <table>
          <thead>
            <tr><th scope="col"><span class="sr">Feature</span></th><th scope="col" class="us">Zafe</th><th scope="col">On-chain multisig</th><th scope="col"><span class="nowrap">Single-key</span> wallet</th></tr>
          </thead>
          <tbody>
            <tr><th scope="row">Several people must approve</th><td class="us yes">Yes</td><td class="yes">Yes</td><td class="no">No</td></tr>
            <tr><th scope="row">Balances and payments stay private</th><td class="us yes">Yes</td><td class="no">No</td><td>If shielded</td></tr>
            <tr><th scope="row">Looks like an ordinary payment</th><td class="us yes">Yes</td><td class="no">No</td><td class="yes">Yes</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section id="faq" class="faq">
      <h2>Questions?</h2>
      <div class="qa">
        {faq.map((item, i) => (
          <details open={i === 0}>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
        <p class="more">More in the <a href={specUrl} target="_blank" rel="noopener noreferrer">spec</a>.</p>
      </div>
    </section>

    <!-- The call to action: the vault's home screen on the vault card colour. -->
    <section class="lp-cta" aria-label="Get Zafe">
      <div class="lp-cta-card">
        <div class="lp-cta-copy">
          <p class="tag plain">Ready when you are</p>
          <h2>Open your vault</h2>
          <p>{getNote}</p>
          <a class="pill" href={getUrl} target="_blank" rel="noopener noreferrer">{getLabel}</a>
        </div>
        <div class="lp-cta-art" aria-hidden="true"><img class="lp-phone" src="/assets/screens/story_bob_home_dark.webp" width="780" height="1688" alt="" loading="lazy" decoding="async" /></div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
