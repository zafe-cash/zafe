---
// Where the waitlist form lands when the address was refused or the store failed
// (api/waitlist.mjs redirects here). noindex, not in the sitemap.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Waitlist from '../components/Waitlist.astro';
---

<Base title="That didn't work · Zafe" description="The iPhone waitlist." bodyClass="not-found" noindex>
  <Nav links={[{ href: '/', label: 'Home', mobile: true, back: true }]} />
  <main class="nf">
    <h1>That didn&rsquo;t work</h1>
    <p class="sub">Check the address and try again. If it keeps failing, write to support@zafe.cash.</p>
    <Waitlist id="iphone-retry" />
  </main>
</Base>
