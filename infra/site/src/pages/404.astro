---
// Served for unknown paths with status 404 (vercel-output.sh routes errors here). noindex,
// and left out of the sitemap.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
---

<Base title="Page not found · Zafe" description="This page doesn't exist." bodyClass="not-found" noindex>
  <Nav links={[{ href: '/', label: 'Home', mobile: true, back: true }]} />
  <main class="nf">
    <h1>Nothing here</h1>
    <p class="sub">This page doesn't exist, or it moved.</p>
    <a class="pill" href="/">Back home</a>
  </main>
</Base>
