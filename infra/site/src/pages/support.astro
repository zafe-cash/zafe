---
// /support: how to reach us first, then the fixes for what goes wrong most, as links into
// /docs/troubleshooting (one anchor each; src/docs/troubleshooting.ts). Labels are checked
// against app/lib. Mail to any @zafe.cash address is forwarded by Cloudflare Email Routing.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { sourceUrl } from '../config';
import { problems } from '../docs/troubleshooting';
---

<Base
  title="Support · Zafe"
  description="Get help with Zafe: write to us, report a bug, or fix the common problems yourself."
  bodyClass="home landing sp-page"
>
  <Nav />

  <main class="sp">
    <h1>How can we help?</h1>

    <ul class="sp-contact">
      <li>
        <a href="mailto:support@zafe.cash"><strong>Email us</strong><span>support@zafe.cash</span></a>
      </li>
      <li>
        <a href={`${sourceUrl}/issues`} target="_blank" rel="noopener noreferrer"><strong>Report a bug</strong><span>GitHub issues, in public</span></a>
      </li>
      <li>
        <a href="mailto:security@zafe.cash"><strong>Security issue</strong><span>security@zafe.cash</span></a>
      </li>
    </ul>
    <p class="sp-note">Attach the diagnostic report from Settings &rsaquo; App &rsaquo; Diagnostic report. Addresses, amounts and keys are removed from it. Never send your backup words: we&rsquo;ll never ask for them.</p>

    <section class="sp-fixes" aria-labelledby="fixes-title">
      <h2 id="fixes-title">Quick fixes</h2>
      <ul class="sp-links">
        {problems.map((p) => (
          <li><a href={`/docs/troubleshooting#${p.id}`}>{p.title}</a></li>
        ))}
      </ul>
      <p class="sp-all"><a href="/docs">All docs</a></p>
    </section>
  </main>

  <Footer />
</Base>
