---
// Showcase: one payment through a 2-of-3 vault, played by scrolling through a 3D world
// (src/scripts/world.js): the phones hold key shards, Bob proposes (the vault is notified,
// end-to-end encrypted), your phone checks the payment, you approve, the shards fuse, the
// vault opens, the payment goes; then the call to action from above. The features live in
// the story where they happen (no detour). Kept off the home page on purpose (a multisig
// product's home should be calm); without WebGL or JavaScript it shows stills of the same
// world (stills.sh). Copy: short, every claim shipped; the chain card is the real testnet
// payment from the 2026-09-30 dry run.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getLabel, getUrl } from '../config';
---

<Base
  title="Zafe showcase: one private payment, start to finish"
  description="Watch a Zafe vault of three phones approve and send a private payment, in 3D."
  bodyClass="home showcase"
>
  <script is:inline src="/assets/boot.js" slot="head"></script>
  <!-- No logo intro here (that's the home page's): the world fades up from the paper
       under a title card, and a light fixed nav keeps the way home in reach. -->
  <canvas class="world" aria-hidden="true"></canvas>
  <!-- The static fallback (no GPU, reduced motion, no JavaScript) shows stills rendered
       from the same world (stills.sh); html.js hides them until story.js decides. The
       hero still is also the poster while the world loads. -->
  <picture class="still hero-still" aria-hidden="true">
    <source media="(max-aspect-ratio: 4/5)" srcset="/assets/stills/hero_tall.webp" width="780" height="1688" />
    <img src="/assets/stills/hero_wide.webp" width="1440" height="900" alt="" fetchpriority="high" decoding="async" />
  </picture>

  <Nav light />

  <main>
    <!-- A title card over the world, not the home page's hero: no buttons, a scroll cue. -->
    <section class="hero">
      <p class="sc-kicker">Zafe, in 3D</p>
      <h1>One payment,<br />start to finish</h1>
      <p class="sub">Three phones share one vault. Scroll to play.</p>
      <p class="scroll-cue" aria-hidden="true"><span>Scroll</span><i></i></p>
    </section>

    <!-- The story: scrolling through this section plays one payment in the 3D world
         behind the page (src/scripts/world.js). Without the world: five rendered beats
         with their captions (.story-beats). -->
    <section class="story" data-beat="10" aria-label="How a shared payment works: each phone holds a share of the key; Bob proposes, your phone checks the payment and you approve, the two shares make the key, the vault opens and the payment is sent">
      <div class="story-pin">
        <h2 class="story-title">How it works</h2>
        <ol class="still story-beats">
          <li>
            <img src="/assets/stills/beat_1.webp" width="1200" height="750" alt="" loading="lazy" decoding="async" />
            <p>Every phone holds a share of the key.</p>
          </li>
          <li>
            <img src="/assets/stills/beat_2.webp" width="1200" height="750" alt="" loading="lazy" decoding="async" />
            <p>Bob proposes a payment.</p>
          </li>
          <li>
            <img src="/assets/stills/beat_3.webp" width="1200" height="750" alt="" loading="lazy" decoding="async" />
            <p>Your phone checks it. You approve with one tap.</p>
          </li>
          <li>
            <img src="/assets/stills/beat_4.webp" width="1200" height="750" alt="" loading="lazy" decoding="async" />
            <p>Two shares make the key. It never exists on any phone.</p>
          </li>
          <li>
            <img src="/assets/stills/beat_5.webp" width="1200" height="750" alt="" loading="lazy" decoding="async" />
            <p>The vault opens. Sent, and on-chain it looks like any payment.</p>
          </li>
        </ol>
        <p class="threshold" aria-hidden="true"><span class="th-num"><span class="th-col"><span>0</span><span>1</span><span>2</span></span></span><span class="th-label">of 2 approvals</span></p>
        <div class="story-captions" aria-live="polite">
          <p class="cap k0">Every phone holds a share of the key.</p>
          <p class="cap k1">One share can&rsquo;t open anything.</p>
          <p class="cap k2">Bob proposes a payment.</p>
          <p class="cap k3">Everyone in the vault is notified, end-to-end encrypted.</p>
          <p class="cap k4">Proposing was his approval. His share goes in.</p>
          <p class="cap k5">Your phone checks the recipient, amount and fee.</p>
          <p class="cap k6">You approve with one tap.</p>
          <p class="cap k7">Two shares make the key. It never exists on any phone.</p>
          <p class="cap k8">The vault opens.</p>
          <p class="cap k9">Sending&hellip;</p>
          <p class="cap k10">Sent. On-chain, it looks like any payment.</p>
        </div>
        <!-- What the chain sees at the end: the real payment from the testnet trial. -->
        <div class="chain-card" aria-hidden="true">
          <p class="chain-title">What the chain sees</p>
          <dl class="chain-mini">
            <div><dt>tx</dt><dd>e6ccd6b7&hellip;9eef0237</dd></div>
            <div><dt>block</dt><dd>4,422,289</dd></div>
            <div><dt>amount</dt><dd>encrypted</dd></div>
            <div><dt>to</dt><dd>encrypted</dd></div>
          </dl>
          <p class="chain-note">A real payment from our testnet trial.</p>
        </div>
      </div>
    </section>

    <!-- The call to action over the world seen from above (world.js). -->
    <section class="cta-world" aria-label="Get Zafe">
      <div class="cta-pin">
        <img class="still cta-still" src="/assets/stills/above.webp" width="1440" height="900" alt="" loading="lazy" decoding="async" />
        <div class="cta-card">
          <p class="tag">That&rsquo;s Zafe</p>
          <h2>Your turn</h2>
          <p>On Google Play and as an APK. Bring your co-signers.</p>
          <a class="pill" href={getUrl}>{getLabel}</a>
          <p class="cta-back"><a href="/">Back to home</a></p>
        </div>
      </div>
    </section>
  </main>

  <Footer slim />
  <script src="../scripts/story.js"></script>
</Base>
