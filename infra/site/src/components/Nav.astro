---
// The nav: page links either side of the mark, the mark exactly centred (the intro lands
// on it; the mark is always the way home). `links` are the left-hand ones, which differ
// per page; on phones the mark moves to the left and only links marked `mobile` stay.
// `light` is the showcase's: fixed over the world, small, a way home on the left and
// Get Zafe on the right, nothing else.
import Mark from './Mark.astro';
import Icon from './Icon.astro';
import { getLabel, getUrl } from '../config';

type Link = { href: string; label: string; mobile?: boolean; back?: boolean };
interface Props {
  links: Link[];
  /** Links before Get Zafe on the right, so each side carries the same weight. */
  right?: Link[];
  light?: boolean;
}
const { links, right = [], light = false } = Astro.props;
---

<header class:list={['nav', { 'nav-light': light }]}>
  <nav class="nav-side left" aria-label="Page">
    {links.map((l) => (
      <a href={l.href} class:list={{ 'nav-m': l.mobile, 'nav-back': l.back }}>
        {l.back && <Icon name="chevron_backward" />}
        {l.label}
      </a>
    ))}
  </nav>
  <a class="nav-logo" href="/" aria-label="Zafe home"><Mark /></a>
  <nav class="nav-side right" aria-label="Links">
    {right.map((l) => (
      <a href={l.href} class:list={{ 'nav-m': l.mobile }}>{l.label}</a>
    ))}
    <a class="nav-m nav-get" href={getUrl}>{getLabel}</a>
  </nav>
</header>
