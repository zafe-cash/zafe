---
// The one nav, the same on every page, pages only (never sections of a page): Docs and
// Security left of the mark, Support and Get Zafe right of it, so both sides carry the
// same weight and the mark sits exactly in the centre (the intro lands on it). The mark
// is the way home, so there is no Home link. On phones the mark moves to the left and
// only Docs and Get Zafe stay.
// `light` is the showcase's: fixed over the world, small, a way home on the left and
// Get Zafe on the right, nothing else.
import Mark from './Mark.astro';
import Icon from './Icon.astro';
import { getLabel, getUrl } from '../config';

interface Props {
  light?: boolean;
}
const { light = false } = Astro.props;
const left = light
  ? [{ href: '/', label: 'Home', mobile: true, back: true }]
  : [
      { href: '/docs', label: 'Docs', mobile: true },
      { href: '/docs/security', label: 'Security' },
    ];
const right = light ? [] : [{ href: '/support', label: 'Support' }];
---

<header class:list={['nav', { 'nav-light': light }]}>
  <nav class="nav-side left" aria-label="Page">
    {left.map((l) => (
      <a href={l.href} class:list={{ 'nav-m': 'mobile' in l && l.mobile, 'nav-back': 'back' in l && l.back }}>
        {'back' in l && l.back && <Icon name="chevron_backward" />}
        {l.label}
      </a>
    ))}
  </nav>
  <a class="nav-logo" href="/" aria-label="Zafe home"><Mark /></a>
  <nav class="nav-side right" aria-label="Links">
    {right.map((l) => (
      <a href={l.href} class:list={{ 'nav-m': l.mobile }}>{l.label}</a>
    ))}
    <a class="nav-m nav-get" href={getUrl}>{getLabel}</a>
  </nav>
</header>
