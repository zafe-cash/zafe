---
// The docs sidebar (wide screens only; phones use the breadcrumb and /docs, which lists
// the same pages). `current` is highlighted and marked aria-current.
import { docHref, sections } from '../docs/pages';

interface Props {
  current?: string;
}
const { current } = Astro.props;
---

<nav class="docs-side" aria-label="Docs">
  <a class="docs-side-home" href="/docs">All docs</a>
  {sections.map((s) => (
    <div class="docs-side-group">
      <p class="docs-side-title">{s.title}</p>
      <ul>
        {s.pages.map((p) => (
          <li>
            <a href={docHref(p.slug)} aria-current={p.slug === current ? 'page' : undefined}>
              {p.label ?? p.title}
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
</nav>
